# Required for search, answer generation, and GEO optimization calls.
OPENAI_API_KEY=sk-...

# Anti-GEO Azure (LLM seeds + --engine azure). Install: pip install 'openai>=1.40'
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-5.5
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Optional: reuse cached LLM responses instead of re-calling the API.
# STATIC_CACHE=True
# GLOBAL_CACHE_FILE=global_cache.json
# GEO_CACHE_FILE=geo_optimizations_cache.json
