# LLM — seed queries (auto) and --engine azure citation discovery.
#
# Setup:
#   cp .env.example .env
#   # paste your key into .env (never commit .env)
#   set -a && source .env && set +a
#
# Install: pip install 'openai>=1.40'
#
# Prefer OpenAI Platform when OPENAI_API_KEY is set; else Azure.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_MAX_COMPLETION_TOKENS=16384

# Fallback Azure OpenAI (used only when OPENAI_API_KEY is unset)
# AZURE_OPENAI_ENDPOINT=https://fangcun-zeng-bj.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-5.6-sol
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_MAX_COMPLETION_TOKENS=16384
# Soft max Bing tool calls for same-brand + permissions judges (tool_choice=auto; default 3)
# AZURE_JUDGE_MAX_TOOL_CALLS=3
# Soft max Bing tool calls for Mode B parasitic GEO judge (falls back to AZURE_JUDGE_MAX_TOOL_CALLS / 3)
# AZURE_PARASITIC_JUDGE_MAX_TOOL_CALLS=3
# Browser fetch (Cloudflare soft wait / headed Chrome / archive / fixtures)
# ANTI_GEO_FETCH=auto
# ANTI_GEO_BROWSER_TIMEOUT=45
# ANTI_GEO_BROWSER_HARD_TIMEOUT=120
# ANTI_GEO_FETCH_HEADED=auto
# ANTI_GEO_FETCH_ARCHIVE=auto
# ANTI_GEO_FETCH_FIXTURE_DIR=data/fetch_fixtures

# Optional: Perplexity instead of Azure for citation discovery
# PERPLEXITY_API_KEY=
