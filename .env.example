# Azure OpenAI — LLM seed queries (auto) and --engine azure citation discovery.
#
# Setup:
#   cp .env.example .env
#   # paste your key into .env (never commit .env)
#   set -a && source .env && set +a
#
# Install: pip install 'openai>=1.40'

AZURE_OPENAI_ENDPOINT=https://fangcun-zeng-bj.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-sol
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Optional: chat completion cap (default 16384; set to none to omit)
# AZURE_OPENAI_MAX_COMPLETION_TOKENS=16384
# Soft max Bing tool calls for same-brand + permissions judges (tool_choice=auto; default 3)
# AZURE_JUDGE_MAX_TOOL_CALLS=3

# Optional: Perplexity instead of Azure for citation discovery
# PERPLEXITY_API_KEY=
